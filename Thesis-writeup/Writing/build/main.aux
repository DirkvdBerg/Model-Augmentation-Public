\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Windows of PS on one record, layout adapted from~\cite  [Fig.~2]{hefny2015supervised}. S1 (top): the encoder maps the window $\chi _\tau $ to $\hat  x^{\mathrm  n}_{\tau |\tau }$, and the decoder $d$ maps its added part $\bar  x_{\tau |\tau }$ to the residuals $e_\tau $ of the next $H$ samples \eqref  {eq:ps2_s1}. S2 (bottom): $g_{\mathrm  {aug}}$ maps $\hat  x^{\mathrm  n}_{\tau |\tau }$ and the recorded $u_\tau $ to the added state encoded from the window shifted by one sample \eqref  {eq:ps2_s2}. \textcolor {red}{[\textbf  {TODO:} The figure shows the target from $\tau +1$ (\texttt  {FINAL-RUN-FIXES.md} item~5). The 2026-10-11 runs start it at $\tau $, so the noise in $y_\tau $ enters both $\chi _\tau $ and $e_\tau $.]}}}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ps2_windows}{{5}{10}{Windows of PS on one record, layout adapted from~\cite [Fig.~2]{hefny2015supervised}. S1 (top): the encoder maps the window $\chi _\tau $ to $\hat x^{\mathrm n}_{\tau |\tau }$, and the decoder $d$ maps its added part $\bar x_{\tau |\tau }$ to the residuals $e_\tau $ of the next $H$ samples \eqref {eq:ps2_s1}. S2 (bottom): $g_{\mathrm {aug}}$ maps $\hat x^{\mathrm n}_{\tau |\tau }$ and the recorded $u_\tau $ to the added state encoded from the window shifted by one sample \eqref {eq:ps2_s2}. \todo {The figure shows the target from $\tau +1$ (\texttt {FINAL-RUN-FIXES.md} item~5). The 2026-10-11 runs start it at $\tau $, so the noise in $y_\tau $ enters both $\chi _\tau $ and $e_\tau $.}}{figure.caption.5}{}}
