\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Windows of PS on one record, layout adapted from~\cite  [Fig.~2]{hefny2015supervised}. S1 (top): the encoder maps the window $\chi _\tau $ to $\hat  x^{\mathrm  n}_{\tau |\tau }$, and the decoder $d$ maps its added part $\bar  x_{\tau |\tau }$ to the residuals $e_\tau $ of the next $H$ samples \eqref  {eq:ps2_s1}. S2 (bottom): $g_{\mathrm  {aug}}$ maps $\hat  x^{\mathrm  n}_{\tau |\tau }$ and the recorded $u_\tau $ to the added state encoded from the window shifted by one sample \eqref  {eq:ps2_s2}. \textcolor {red}{[\textbf  {TODO:} The figure shows the target from $\tau +1$ (\texttt  {FINAL-RUN-FIXES.md} item~5). Item~5 is superseded by item~8 (2026-10-16): the final runs end $\chi _\tau $ at $\tau -1$ and start the target at $\tau $, so the figure must show $\chi _\tau $ up to $\tau -1$ and $e_\tau $ from $\tau $ to $\tau +H-1$.]}}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ps2_windows}{{5}{11}{Windows of PS on one record, layout adapted from~\cite [Fig.~2]{hefny2015supervised}. S1 (top): the encoder maps the window $\chi _\tau $ to $\hat x^{\mathrm n}_{\tau |\tau }$, and the decoder $d$ maps its added part $\bar x_{\tau |\tau }$ to the residuals $e_\tau $ of the next $H$ samples \eqref {eq:ps2_s1}. S2 (bottom): $g_{\mathrm {aug}}$ maps $\hat x^{\mathrm n}_{\tau |\tau }$ and the recorded $u_\tau $ to the added state encoded from the window shifted by one sample \eqref {eq:ps2_s2}. \todo {The figure shows the target from $\tau +1$ (\texttt {FINAL-RUN-FIXES.md} item~5). Item~5 is superseded by item~8 (2026-10-16): the final runs end $\chi _\tau $ at $\tau -1$ and start the target at $\tau $, so the figure must show $\chi _\tau $ up to $\tau -1$ and $e_\tau $ from $\tau $ to $\tau +H-1$.}}{figure.caption.5}{}}
