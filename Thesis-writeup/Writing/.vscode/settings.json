{
    // Build outside OneDrive (D-277); must match $out_dir and $aux_dir in .latexmkrc.
    "latex-workshop.latex.outDir": "C:/Users/20203253/Documents/School/AI & Engineering systems/2025-2026/Thesis/build",
    // Keep this file equivalent to the repository-root settings for users who
    // open Writing/ directly as their VS Code workspace.
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.search.rootFiles.include": [
        "main.tex"
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "thesis-latexmk",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            // Runs only after a successful build, so a failed build leaves the
            // last good PDF in build/.
            "name": "copy-to-writing-build",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-Command",
                "Copy-Item -LiteralPath '%OUTDIR%/%DOCFILE%.pdf', '%OUTDIR%/%DOCFILE%.synctex.gz', '%OUTDIR%/%DOCFILE%.log' -Destination '%DIR%/build' -Force"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "Thesis latexmk",
            "tools": ["thesis-latexmk", "copy-to-writing-build"]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",

    // No AI inline completions in TeX files: the thesis text is written by hand.
    "github.copilot.enable": {
        "*": true,
        "latex": false,
        "tex": false,
        "bibtex": false
    },
    "[latex]": {
        "editor.inlineSuggest.enabled": false
    }
}
