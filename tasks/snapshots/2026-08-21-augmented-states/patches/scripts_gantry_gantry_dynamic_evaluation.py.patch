+def standalone_baseline_test(fit_sys, hp, cfg: RunConfig, data, norm):
+    """Standalone-baseline test: the negation detector (plan Step 10, D7.9 layer 2).
+
+    Strip the ANN: simulate the FP model ALONE on the primary val and test
+    records (true-x0 @K0 init, same convention as the existing baselines,
+    D-072/D-087) with three parameter vectors:
+      theta_hat   the trained block's learned parameters (in-place, read-only)
+      theta_init  the run's anchor (deepcopy with log_params zeroed)
+      theta_0     nominal (plain Gantry_State_Block, default path)
+    Negation signature ([GYOROK] Table 1): NRMS(theta_hat) >> NRMS(theta_0)
+    while the augmented model fits well. Truth-free: uses only the learned
+    parameters and held-out data — the selector quantity for the beta sweep.
+
+    Returns {tag: {nrms_hat, nrms_init, nrms_nominal}} or None (not a joint run).
+    """
+    from copy import deepcopy
+    from .baselines import compute_baseline_fp_nrms
+
+    pblocks = [m for m in fit_sys.hfn.connected_blocks if hasattr(m, 'physical_params')]
+    if not pblocks:
+        return None
+    blk_hat = pblocks[0]
+    blk_init = deepcopy(blk_hat)
+    with torch.no_grad():
+        blk_init.log_params.data.zero_()          # theta = params_init anchor
+
+    na, nb, _, _ = get_encoder_dims(hp, cfg)
+    K0 = max(na, nb)
+    agg = lambda n: float(np.sqrt(np.mean((n * norm.ystd) ** 2)))   # deepSI RMS formula
+
+    print('\n== E. STANDALONE-BASELINE TEST (negation detector, plan Step 10) ==')
+    out = {}
+    for tag, sd, xlog in (('val',  data.val_data,  data.val_x_logical),
+                          ('test', data.test_data, data.test_x_logical)):
+        if xlog is None:
+            continue
+        x0 = xlog[K0]
+        n_hat, _ = compute_baseline_fp_nrms(
+            hp, cfg, data, norm, data_sd=sd, x0_phys=x0, start_ix=K0,
+            label=f'{tag}, STANDALONE theta_hat (ANN stripped)', phy_block=blk_hat)
+        n_init, _ = compute_baseline_fp_nrms(
+            hp, cfg, data, norm, data_sd=sd, x0_phys=x0, start_ix=K0,
+            label=f'{tag}, STANDALONE theta_init (anchor)', phy_block=blk_init)
+        n_nom, _ = compute_baseline_fp_nrms(
+            hp, cfg, data, norm, data_sd=sd, x0_phys=x0, start_ix=K0,
+            label=f'{tag}, nominal theta_0')
+        r_nom, r_init = agg(n_hat) / agg(n_nom), agg(n_hat) / agg(n_init)
+        print(f'  [{tag}] aggregate sim-RMS [m]:  theta_hat {agg(n_hat):.4e}   '
+              f'theta_init {agg(n_init):.4e}   nominal {agg(n_nom):.4e}')
+        print(f'  [{tag}] ratios:  hat/nominal = {r_nom:.3f}   hat/init = {r_init:.3f}   '
+              f'(>>1 vs nominal = negation; <1 vs init = recovery)')
+        out[tag] = dict(nrms_hat=n_hat, nrms_init=n_init, nrms_nominal=n_nom)
+    return out
+
