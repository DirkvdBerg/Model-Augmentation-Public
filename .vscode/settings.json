{
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",

    "latex-workshop.latex.outDir": "%DIR%/build",
    // Workflow invariant: every save of an included TeX file rebuilds the single
    // root below, producing build/main.pdf and build/main.synctex.gz together.
    // onSave, not onFileChange: changes written from outside the editor (AI edits,
    // OneDrive, git) started overlapping builds that aborted on a locked main.aux
    // and left no main.synctex.gz, which broke double-click.
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.search.rootFiles.include": [
        "Thesis-writeup/Writing/main.tex"
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "thesis-latexmk",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "Thesis latexmk",
            "tools": ["thesis-latexmk"]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",

    // No AI inline completions in TeX files: the thesis text is written by hand.
    "github.copilot.enable": {
        "*": true,
        "latex": false,
        "tex": false,
        "bibtex": false
    },
    "[latex]": {
        "editor.inlineSuggest.enabled": false
    }
}
