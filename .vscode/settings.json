{
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",

    // Build outside OneDrive (D-277): OneDrive locks files in a synced build folder
    // while it uploads them, and pdflatex then aborts with "I can't write on file".
    // Must match $out_dir and $aux_dir in Thesis-writeup/Writing/.latexmkrc.
    "latex-workshop.latex.outDir": "C:/Users/20203253/Documents/School/AI & Engineering systems/2025-2026/Thesis/build",
    // Workflow invariant: every save of an included TeX file rebuilds the single
    // root below; the recipe then copies main.pdf, main.synctex.gz and main.log
    // together to Thesis-writeup/Writing/build/, where the PDF is opened.
    // onSave, not onFileChange: changes written from outside the editor (AI edits,
    // OneDrive, git) started overlapping builds that aborted on a locked main.aux
    // and left no main.synctex.gz, which broke double-click.
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.search.rootFiles.include": [
        "Thesis-writeup/Writing/main.tex"
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "thesis-latexmk",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            // Runs only after a successful build, so a failed build leaves the
            // last good PDF in Writing/build/.
            "name": "copy-to-writing-build",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-NonInteractive",
                "-Command",
                "Copy-Item -LiteralPath '%OUTDIR%/%DOCFILE%.pdf', '%OUTDIR%/%DOCFILE%.synctex.gz', '%OUTDIR%/%DOCFILE%.log' -Destination '%DIR%/build' -Force"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "Thesis latexmk",
            "tools": ["thesis-latexmk", "copy-to-writing-build"]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",

    // No AI inline completions in TeX files: the thesis text is written by hand.
    "github.copilot.enable": {
        "*": true,
        "latex": false,
        "tex": false,
        "bibtex": false
    },
    "[latex]": {
        "editor.inlineSuggest.enabled": false
    }
}
